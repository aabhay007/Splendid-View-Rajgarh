# Splendid View Rajgarh - Environment Configuration Template
# Copy this file to .env.local for local development

# Canonical Production URL (No trailing slash)
NEXT_PUBLIC_SITE_URL=https://splendidviewrajgarh.com

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID={{TODO: G-XXXXXXXXXX}}

# Google Search Console Verification Token (Optional meta tag verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION={{TODO: your_google_site_verification_string}}

# Email notifications for Enquiry Form (Optional - connect to Resend or your SMTP provider)
RESEND_API_KEY={{TODO: re_123456789}}
ENQUIRY_NOTIFICATION_EMAIL={{TODO: reservations@splendidviewrajgarh.com}}
